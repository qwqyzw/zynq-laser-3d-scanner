# Read the completed routed checkpoint, and check the physical UART pins.
# No board connection or programming. Usage: vivado -mode batch -source
# scripts/audit_motor_uart_overlay.tcl -tclargs ?build_dir?
set project_root [file normalize [file join [file dirname [info script]] ..]]
set build_dir [file join $project_root build motor_uart]
if {[llength $argv] > 0} {set build_dir [file normalize [lindex $argv 0]]}
if {[llength $argv] > 1} {error "Too many arguments"}
set reports [file join $project_root reports motor_uart]
file mkdir $reports
open_checkpoint [file join $build_dir ls.runs impl_1 bd_wrapper_routed.dcp]
foreach {port pin direction} {motor_uart_rx T14 IN motor_uart_tx U12 OUT} {
    set item [get_ports $port]
    if {[llength $item] != 1} {error "Missing UART port: $port"}
    foreach {property expected} [list PACKAGE_PIN $pin DIRECTION $direction IOSTANDARD LVCMOS33] {
        if {[get_property $property $item] ne $expected} {
            error "UART $port $property differs from expected $expected: [get_property $property $item]"
        }
    }
}
if {![get_property PULLUP [get_ports motor_uart_rx]]} {error "Missing RX idle pullup"}
# Clock names are generated by the PS7 constraint file; all clocks must be 20 ns.
if {[llength [get_clocks]] != 1} {error "Expected one fabric clock, found [get_clocks]"}
set clock [lindex [get_clocks] 0]
if {abs([get_property PERIOD $clock] - 20.0) > 0.0001} {error "Expected 50 MHz fabric clock"}
set setup [get_timing_paths -setup -max_paths 1]
set hold [get_timing_paths -hold -max_paths 1]
if {[llength $setup] != 1 || [get_property SLACK $setup] < 0} {error "Failed setup timing"}
if {[llength $hold] != 1 || [get_property SLACK $hold] < 0} {error "Failed hold timing"}
report_io -file [file join $reports motor_uart_impl_io.rpt]
report_clocks -file [file join $reports motor_uart_impl_clocks.rpt]
report_drc -file [file join $reports motor_uart_audit_drc.rpt]
set errors [get_drc_violations -quiet -filter {SEVERITY == Error}]
set critical [get_drc_violations -quiet -filter {SEVERITY == "Critical Warning"}]
if {[llength $errors] || [llength $critical]} {error "DRC error/critical warning exists"}
set audit [open [file join $reports motor_uart_hardware_audit.txt] w]
puts $audit "MOTOR_UART_PHYSICAL_AUDIT_PASS"
puts $audit "checkpoint=[file join $build_dir ls.runs impl_1 bd_wrapper_routed.dcp]"
puts $audit "UART RX=Arduino D0=T14 IN LVCMOS33 pullup=1"
puts $audit "UART TX=Arduino D1=U12 OUT LVCMOS33"
puts $audit "clock=$clock period_ns=[get_property PERIOD $clock]"
puts $audit "setup_slack_ns=[get_property SLACK $setup]"
puts $audit "hold_slack_ns=[get_property SLACK $hold]"
puts $audit "DRC_errors=[llength $errors]; DRC_critical_warnings=[llength $critical]"
close $audit
puts "MOTOR_UART_PHYSICAL_AUDIT_PASS"
close_design
exit
